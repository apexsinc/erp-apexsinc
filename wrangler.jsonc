{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apexsinc-erp-app",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "erp-db",
      "database_id": "erp-db-local-id",
      "migrations_dir": "drizzle"
    }
  ]
}
