{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apexsinc-erp-app",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apexsinc-erp-db",
      "database_id": "b682c62b-31f5-4244-a861-bf72c979c6a4",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [
    {
      "pattern": "erp.apexsinc.com",
      "custom_domain": true
    }
  ],
  // Public widget id (safe to commit). Matching secret is set separately via:
  //   wrangler secret put TURNSTILE_SECRET_KEY
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEWXjWO9n9rN0ZIi"
  }
}

